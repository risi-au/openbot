{
  "display_information": {
    "name": "OpenBot Local Bridge",
    "description": "Send explicit Slack mentions to an OpenBot agent on your own host."
  },
  "features": {
    "bot_user": { "display_name": "OpenBot Local Bridge", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false
  }
}
